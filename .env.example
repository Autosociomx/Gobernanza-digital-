# =============================================================================
# NAYARIT DIGITAL — Variables de Entorno
# Copia este archivo como .env y rellena cada valor.
# NUNCA subas .env al repositorio.
# =============================================================================

# --- FIREBASE (cliente) ---
# Obtener en: Firebase Console → Project Settings → General → Web Apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=

# --- GOOGLE MAPS (cliente) ---
# Restringir en Google Cloud Console a dominios autorizados únicamente
VITE_GOOGLE_MAPS_API_KEY=
# Alias heredado — usar VITE_GOOGLE_MAPS_API_KEY en código nuevo
GOOGLE_MAPS_PLATFORM_KEY=
GOOGLE_MAPS_API_KEY=

# --- GEMINI AI (solo servidor — NUNCA usar prefijo VITE_) ---
GEMINI_API_KEY=

# --- STRIPE ---
# Secret key: solo servidor
STRIPE_SECRET_KEY=
# Public key: cliente (prefijo VITE_ obligatorio)
VITE_STRIPE_PUBLIC_KEY=
