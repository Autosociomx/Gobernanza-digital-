# .env.example
# Google Maps Platform
GOOGLE_MAPS_PLATFORM_KEY=

# Gemini AI
GEMINI_API_KEY=
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLIC_KEY=
GOOGLE_MAPS_API_KEY=

# Anthropic (agente CEO de "Agentes Federales" — opcional, con respaldo automático a Gemini si no se configura)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# INEGI API de indicadores (opcional — activa el agente INEGI; token gratuito en inegi.org.mx > Desarrolladores)
INEGI_API_TOKEN=
