# .env.example — ConnectX / Nayarit Digital
# Copia este archivo a .env.local y completa los valores

# ── Google Cloud ──────────────────────────────────
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=

# ── Stripe Payments ───────────────────────────────
# Obtener en: https://dashboard.stripe.com/apikeys
# Usar claves TEST (sk_test_...) para desarrollo
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook secret (stripe listen --forward-to localhost:3000/api/payments/webhook)
STRIPE_WEBHOOK_SECRET=whsec_...
