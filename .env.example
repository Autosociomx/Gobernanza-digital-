# .env.example — Nayarit Digital

# Motor de IA — Anthropic Claude (solo servidor, nunca se expone al cliente)
ANTHROPIC_API_KEY=

# Google Maps Platform (mapas y geolocalización)
GOOGLE_MAPS_PLATFORM_KEY=
GOOGLE_MAPS_API_KEY=

# Stripe (pagos: predial, agua, multas, licencias)
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLIC_KEY=
