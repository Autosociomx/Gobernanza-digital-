# .env.example
# Google Maps Platform
GOOGLE_MAPS_PLATFORM_KEY=

# Gemini AI (sillas E2, E5, E8, E11, E14 del Gabinete + chat ConnectX)
GEMINI_API_KEY=

# Gabinete Digital de Especialistas (opcionales: sin ellas, esas sillas
# constan como "ausentes" y las sesiones continúan con las demás)
# Groq (sillas E1, E4, E7, E10, E13) — capa gratuita en console.groq.com
GROQ_API_KEY=
# Anthropic (sillas E3, E6, E9, E12, E15) — console.anthropic.com
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLIC_KEY=
GOOGLE_MAPS_API_KEY=
