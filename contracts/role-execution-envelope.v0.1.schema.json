{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connectx.mx/schemas/role-execution-envelope.v0.1.schema.json",
  "title": "ConnectX Role Execution Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "execution",
    "role",
    "capability",
    "context",
    "policy",
    "request",
    "evidence"
  ],
  "properties": {
    "spec_version": {
      "const": "0.1"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_id", "trace_id", "timestamp"],
      "properties": {
        "execution_id": { "type": "string", "format": "uuid" },
        "trace_id": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_id", "version"],
      "properties": {
        "role_id": { "const": "evidence.auditor" },
        "version": { "const": "0.1.0" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "version", "authority_scope"],
      "properties": {
        "capability_id": { "const": "gov.mx.evidence.verify_claim" },
        "version": { "const": "0.1.0" },
        "authority_scope": { "const": "advisory" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_handle", "case_id", "purpose"],
      "properties": {
        "context_handle": { "type": "string", "minLength": 1 },
        "case_id": { "type": "string", "minLength": 1 },
        "jurisdiction": { "type": "string" },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version"],
      "properties": {
        "policy_version": { "type": "string", "minLength": 1 },
        "human_approval_required": { "type": "boolean" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "claim"],
      "properties": {
        "task": { "const": "verify_claim" },
        "claim": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim_id", "text"],
          "properties": {
            "claim_id": { "type": "string", "minLength": 1 },
            "text": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "source_id", "checksum_sha256", "content"],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1 },
          "source_id": { "type": "string", "minLength": 1 },
          "checksum_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "locator": { "type": "string" },
          "content": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
