{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connectx.mx/schemas/evidence-auditor-envelope.v0.1.schema.json",
  "title": "Evidence Auditor Envelope v0.1",
  "description": "Specialized P0.6 input contract for evidence.auditor / gov.mx.evidence.verify_claim. This is not yet a universal Role envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "execution", "role", "capability", "context", "policy", "request", "evidence"],
  "properties": {
    "spec_version": { "const": "0.1" },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_id", "trace_id", "timestamp"],
      "properties": {
        "execution_id": { "type": "string", "format": "uuid" },
        "trace_id": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_id", "version"],
      "properties": {
        "role_id": { "const": "evidence.auditor" },
        "version": { "const": "0.1.0" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "version", "authority_scope"],
      "properties": {
        "capability_id": { "const": "gov.mx.evidence.verify_claim" },
        "version": { "const": "0.1.0" },
        "authority_scope": { "const": "advisory" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_handle", "case_id", "jurisdiction", "purpose"],
      "properties": {
        "context_handle": {
          "type": "string",
          "minLength": 1,
          "description": "P0.6 portability-context identifier. It is not asserted to be a current ContextOSRuntime field."
        },
        "case_id": { "type": "string", "minLength": 1 },
        "jurisdiction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["country", "state", "municipality"],
          "properties": {
            "country": { "const": "MX" },
            "state": { "type": "string", "minLength": 1 },
            "municipality": { "type": "string", "minLength": 1 }
          }
        },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version"],
      "properties": {
        "policy_version": { "const": "contextos.policy.evidence-auditor.v0.1" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "claim"],
      "properties": {
        "task": { "const": "verify_claim" },
        "claim": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim_id", "text"],
          "properties": {
            "claim_id": { "type": "string", "minLength": 1 },
            "text": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_evidence_id",
          "source_id",
          "data_classification",
          "snapshot_sha256",
          "analysis_content_sha256",
          "content_derivation",
          "content"
        ],
        "properties": {
          "source_evidence_id": {
            "type": "string",
            "minLength": 1,
            "description": "Identity of frozen source evidence. It is intentionally distinct from Context.OS EvidenceRecord.evidenceId."
          },
          "source_id": { "type": "string", "minLength": 1 },
          "data_classification": {
            "const": "PUBLIC_ONLY",
            "description": "P0.6 admits only public institutional or publicly disseminated evidence. Personal or unknown data is rejected before canonical input creation."
          },
          "snapshot_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$",
            "description": "SHA-256 of the exact captured source snapshot bytes."
          },
          "analysis_content_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$",
            "description": "SHA-256 of the exact UTF-8 content string supplied to the reasoning provider."
          },
          "content_derivation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "version"],
            "properties": {
              "method": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            }
          },
          "locator": { "type": "string" },
          "content": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
